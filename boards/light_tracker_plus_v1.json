[env:light-tracker-plus]
extends = esp32s3_base
board = light_tracker_plus_v1

build_flags =
    ${esp32s3_base.build_flags}
    -D PRIVATE_HW
    -D ARDUINO_LightTracker_Plus
    -D ARDUINO_RUNNING_CORE=1
    -D ARDUINO_EVENT_RUNNING_CORE=1
    -D ARDUINO_USB_CDC_ON_BOOT=1
    -I variants/light_tracker_plus

upload_speed                        = 460800
board_build.flash_mode              = qio
board_build.f_flash                 = 80000000L
board_build.flash_size              = 8MB
board_build.partitions              = default_8MB.csv
board_upload.use_1200bps_touch      = true
board_upload.wait_for_upload_port   = true
board_upload.require_upload_port    = true

monitor_filters = esp32_exception_decoder
